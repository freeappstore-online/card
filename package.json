{
  "name": "card",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @card/web dev",
    "build": "pnpm --filter @card/web build",
    "preview": "pnpm --filter @card/web preview",
    "typecheck": "pnpm --filter @card/web exec tsc -b",
    "test": "pnpm --filter @card/web test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@freeappstore/sdk": "^0.16.39"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  },
  "description": "Make a contact card, download a vCard, and explicitly publish a public page with a QR code."
}
