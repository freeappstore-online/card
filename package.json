{
  "name": "card",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @card/web dev",
    "build": "pnpm --filter @card/web build",
    "preview": "pnpm --filter @card/web preview",
    "typecheck": "pnpm --filter @card/web exec tsc -b",
    "test": "pnpm --filter @card/web test"
  },
  "dependencies": {
    "@freeappstore/sdk": "^0.16.39"
  }
}
